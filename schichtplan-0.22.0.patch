-    company_id: profile.company_id,
-    shift_id: shiftId,
-    key: "urlaubssperre",
-    value: { start: startDate, end: endDate, reason },
-    active: true,
-  });
-
-  if (error) {
-    return { error: dataErrorMessage(error) ?? "Die Urlaubssperre konnte nicht gespeichert werden." };
